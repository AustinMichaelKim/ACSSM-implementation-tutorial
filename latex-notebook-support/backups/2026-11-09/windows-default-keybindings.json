// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+oem_7",
        "command": "workbench.action.terminal.toggleTerminal",
        "when": "terminal.active"
    },
    {
        "key": "ctrl+oem_3",
        "command": "-workbench.action.terminal.toggleTerminal",
        "when": "terminal.active"
    },
    {
        "key": "ctrl+shift+oem_7",
        "command": "workbench.action.terminal.new",
        "when": "terminalProcessSupported || terminalWebExtensionContributedProfile"
    },
    {
        "key": "ctrl+shift+oem_3",
        "command": "-workbench.action.terminal.new",
        "when": "terminalProcessSupported || terminalWebExtensionContributedProfile"
    },
    {
        "key": "ctrl+oem_1",
        "command": "workbench.action.toggleMaximizedPanel",
        "when": "panelAlignment == 'center' || panelPosition != 'bottom' && panelPosition != 'top'"
    },
    {
        "key": "ctrl+b",
        "command": "latex-workshop.build",
        "when": "editorTextFocus && editorLangId == latex"
     },
    {
        "key": "ctrl+alt+p",
        "command": "workbench.action.toggleWindowAlwaysOnTop"
    },
    {
  "key": "alt+-",
  "command": "latexSmartTab.insertSnippetTemplate",
  "when": "editorTextFocus && editorLangId == latex && !editorReadonly",
  "args": {
    "snippet": "_{$1}$0"
  }
},
{
  "key": "alt+1",
  "command": "latexSmartTab.insertSnippetTemplate",
  "when": "editorTextFocus && editorLangId == latex && !editorReadonly",
  "args": {
    "snippet": "^{$1}$0"
  }
},
{
  "key": "alt+2",
  "command": "latexSmartTab.insertSnippetTemplate",
  "when": "editorTextFocus && editorLangId == latex && !editorReadonly",
  "args": {
    "snippet": "^{2}$0"
  }
},
{
  "key": "alt+3",
  "command": "latexSmartTab.insertSnippetTemplate",
  "when": "editorTextFocus && editorLangId == latex && !editorReadonly",
  "args": {
    "snippet": "^{3}$0"
  }
},
    
  {
    "key": "ctrl+b",
    "command": "latex-workshop.build",
    "when": "editorTextFocus && editorLangId == latex"
  },

  {
    "key": "tab",
    "command": "latexSmartTab.navigatePlain",
    "when": "editorTextFocus && editorLangId == latex && !editorReadonly && !editorHasMultipleSelections && !editorTabMovesFocus && !hasSnippetCompletions && !inSnippetMode"
  },

  {
    "key": "tab",
    "command": "latexSmartTab.navigateSnippet",
    "when": "editorTextFocus && editorLangId == latex && !editorReadonly && !editorHasMultipleSelections && !editorTabMovesFocus && !hasSnippetCompletions && inSnippetMode && hasNextTabstop"
  },

  {
    "key": "tab",
    "command": "latexSmartTab.expandSnippet",
    "when": "editorTextFocus && editorLangId == latex && !editorReadonly && !editorHasMultipleSelections && !editorTabMovesFocus && hasSnippetCompletions"
  },
  {
  "key": "space",
  "command": "latexSmartTab.insertContinuationSpace",
  "when": "editorTextFocus && editorLangId == latex && !editorReadonly && !editorHasMultipleSelections && inSnippetMode && editorHasSelection && config.latexSmartTab.preserveUntouchedTerminalDefaultOnSpace"
  },
  {
    "key" : "ctrl+d ctrl+s",
    "command": "editor.action.insertSnippet",
    "when" : "editorTextFocus && editorLangId == latex" ,
    "args" : {"snippet":"% !TeX program = xelatex\n\\documentclass[11pt,a4paper]{article}\n\n% ---------- Language and layout ----------\n\\usepackage[margin=25mm]{geometry}\n\\usepackage{microtype}\n\\usepackage{setspace}\n\\setstretch{1.15}\n\\setlength{\\parindent}{0pt}\n\\setlength{\\parskip}{0.5em}\n\n% ---------- Mathematics ----------\n\\usepackage{amsmath,amssymb,amsthm,mathtools}\n\\usepackage{bm}\n\\allowdisplaybreaks\n\\numberwithin{equation}{section}\n\\usepackage[version=4]{mhchem}\n\n% ---------- Figures and tables ----------\n\\usepackage{graphicx}\n\\usepackage{booktabs}\n\\usepackage{array}\n\\usepackage{enumitem}\n\n% ---------- Links ----------\n\\usepackage{xcolor}\n\\usepackage{hyperref}\n\\hypersetup{colorlinks=true,linkcolor=blue,citecolor=blue,urlcolor=blue}\n\n% ---------- Operators and commands ----------\n\\DeclareMathOperator{\\Var}{Var}\n\\DeclareMathOperator{\\Cov}{Cov}\n\\DeclareMathOperator{\\Corr}{Corr}\n\\DeclareMathOperator{\\rank}{rank}\n\\DeclareMathOperator{\\tr}{tr}\n\\DeclareMathOperator*{\\argmin}{arg\\,min}\n\\DeclareMathOperator*{\\argmax}{arg\\,max}\n\\newcommand{\\E}{\\mathbb{E}}\n\\newcommand{\\Prob}{\\mathbb{P}}\n\\newcommand{\\R}{\\mathbb{R}}\n\\newcommand{\\Q}{\\mathbb{Q}}\n\\newcommand{\\dd}{\\,\\mathrm{d}}\n\\newcommand{\\ind}{\\mathbf{1}}\n\\newcommand{\\pd}[2]{\\frac{\\partial #1}{\\partial #2}}\n\\DeclarePairedDelimiter{\\abs}{\\lvert}{\\rvert}\n\\DeclarePairedDelimiter{\\norm}{\\lVert}{\\rVert}\n\\DeclarePairedDelimiter{\\inner}{\\langle}{\\rangle}\n\n% ---------- Theorem environments ----------\n\\newtheorem{theorem}{Theorem}[section]\n\\newtheorem{lemma}[theorem]{Lemma}\n\\newtheorem{proposition}[theorem]{Proposition}\n\\theoremstyle{definition}\n\\newtheorem{definition}[theorem]{Definition}\n\\newtheorem{example}[theorem]{Example}\n\\theoremstyle{remark}\n\\newtheorem*{remark}{Remark}\n\n\\title{${1:문서 제목}}\n\\author{${2:작성자}}\n\\date{\\today}\n\n\\begin{document}\n\n\\maketitle\n\\tableofcontents\n\\newpage\n\n$0\n\n\\end{document}\n"}

  }


    

]