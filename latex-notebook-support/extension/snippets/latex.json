// ============================================================================
// LaTeX 사용자 스니펫 — LaTeX Smart Tab Dispatcher 0.2.6 호환본
// ============================================================================
//
// [이 파일이 전제하는 입력 규칙과 VS Code 설정]
// - 스니펫 확장: prefix + Tab
// - 일반 IntelliSense suggestion 승인: Enter
// - Tab 우선순위: 일치하는 prefix > 가장 안쪽 토큰 탈출 > 다음 tab stop
// - editor.tabCompletion = "onlySnippets", editor.snippetSuggestions = "none",
//   editor.acceptSuggestionOnEnter = "on" 및 Smart Tab 0.2.6 keybinding을 전제한다.
//
// [새 스니펫을 추가하거나 기존 스니펫을 고칠 때 지켜야 할 규칙]
// 1. Prefix 충돌
//    VS Code는 현재 커서 왼쪽의 비공백 문자열이 prefix로 "끝나는지" 검사한다.
//    따라서 prefix의 완전 중복뿐 아니라 suffix 중복도 피해야 한다.
//    예: "prodd"는 "dd"로 끝나므로 Product와 Ordinary derivative가 충돌한다.
//    짧은 그리스 문자 prefix에는 ";al", ";si"처럼 앞에 세미콜론을 붙인다.
//
// 2. Placeholder 번호
//    이동 순서에 맞게 ${1}, ${2}, ...를 사용하고, $0은 스니펫 끝에 정확히
//    한 번만 둔다. 같은 번호를 반복하는 것은 begin/end 환경명처럼 동일한
//    값을 거울처럼 재사용하려는 경우에만 허용한다.
//
// 3. 닫는 리터럴 뒤의 continuation placeholder
//    마지막 내용 placeholder 뒤에 }, \right), ] 같은 닫는 리터럴이 남는
//    구조는 닫는 리터럴 뒤에 일반 placeholder를 하나 두고 그 뒤에 $0을 둔다.
//    예:
//      \bar{${1:x}}${2}$0
//      \left(${1}\right)${2}$0
//      \frac{${1:numerator}}{${2:denominator}}${3}$0
//    이렇게 해야 중첩 스니펫의 $0가 유일한 연결 지점이 되어 보이지 않는
//    중간 tab stop을 만드는 문제를 줄일 수 있다.
//
// 4. 불필요한 continuation placeholder 금지
//    마지막 의미 있는 placeholder가 이미 스니펫 출력의 맨 끝에 있는 경우에는
//    같은 위치에 빈 placeholder를 하나 더 추가하지 않는다.
//    예: summation, integral, limit, product. Smart Tab 0.2.6이 같은 위치의
//    final stop을 건너뛰더라도 불필요한 placeholder는 중첩 구조만 복잡하게 만든다.
//
// 5. 연속된 LaTeX 인수
//    \frac{...}{...}처럼 여러 인수를 받는 명령은 각 인수마다 독립 placeholder를
//    둔다. Smart Tab 0.2.6은 "}{" 사이를 편집 위치로 보지 않고 다음 인수로
//    이동하도록 설계되어 있다.
//
// 6. 닫는 delimiter와 environment 등록
//    새로운 delimiter/environment 스니펫을 추가하면 닫는 토큰을
//    latexSmartTab.closingTokens에도 등록한다. display block 종료 후 다음 물리적
//    줄로 이동해야 한다면 blockClosingTokens에도 등록한다.
//    원시 "|"는 절댓값의 여는 기호와 닫는 기호를 구분하기 어려우므로 등록하지 않는다.
//
// 7. Generic environment의 한계
//    "beg"는 임의의 \end{...}를 만들 수 있다. snippet mode가 끝난 뒤에는 등록되지
//    않은 custom closer를 Smart Tab이 인식하지 못할 수 있다. 자주 쓰는 환경은
//    전용 스니펫을 만들고 닫는 토큰도 명시적으로 등록한다.
//
// 8. Keybinding에서 직접 삽입하는 스니펫
//    Alt 조합 등으로 스니펫을 직접 넣을 때는 "editor.action.insertSnippet"이 아니라
//    "latexSmartTab.insertSnippetTemplate" 명령을 사용한다. 그렇지 않으면 스니펫이
//    만든 닫는 토큰을 사용자가 직접 입력한 토큰으로 잘못 분류할 수 있다.
//
// 9. LaTeX control word 종료
//    \alpha 뒤에 x를 바로 입력하면 \alphax라는 잘못된 명령이 될 수 있다.
//    따라서 그리스 문자 스니펫은 \alpha{}, \sigma{}처럼 빈 그룹으로 명령을
//    종료한다. 빈 그룹은 렌더링 결과에 영향을 주지 않는다.
//
// 10. 필요한 패키지
//     이 파일은 일반적으로 amsmath, amssymb(또는 amsfonts), bm을 전제한다.
//     새 명령을 추가할 때 필요한 패키지도 preamble에 추가한다.
//
// [구조 스니펫 추가 후 최소 회귀 테스트]
// - \frac{x_{1|}}{denominator}: Tab으로 내부 } 탈출 후 다음 Tab에 denominator 선택
// - \frac{\sum ... \bar{X} ... |}{denominator}: 한 번의 Tab으로 denominator 이동
// - \left(\sum ... |\right): 한 번의 Tab으로 \right) 뒤, 다음 Tab으로 block 탈출
// - suggestion 창이 떠 있어도 정확한 prefix가 있으면 prefix + Tab이 우선 실행
//
// ============================================================================

{
  // ========================================================================
  // 1. 수식 wrapper 및 environment
  // ========================================================================

  "Inline math": {
    "prefix": "mk",
    "body": "\\(${1}\\)$0",
    "description": "Inline math"
  },

  "Display math": {
    "prefix": "dm",
    "body": [
      "\\[",
      "\t${1}",
      "\\]",
      "$0"
    ],
    "description": "Display math block"
  },

  "Equation environment": {
    "prefix": "eq",
    "body": [
      "\\begin{equation}",
      "\t${1}",
      "\\end{equation}",
      "$0"
    ],
    "description": "Numbered equation"
  },

  "Align environment": {
    "prefix": "ali",
    "body": [
      "\\begin{align*}",
      "\t${1:left} &= ${2:right}",
      "\\end{align*}",
      "$0"
    ],
    "description": "Unnumbered align environment"
  },

  "Align nextline equation" : {
    "prefix" : "anl",
    "body": [
      "\\\\\\\\",
      "&= ${1}$0"
    ],
    "description": "align nextline equation"
  },

  // repetative use of "anle" makes the set of a=b equations aligned with =.
  "Align nextline a=b equation " : {
    "prefix" : "anle",
    "body": [
      "\\\\\\\\",
      "${1:left} &= ${2:right}${3}$0"
    ],
    "description": "align nextline a=b equation"
  },

  "Generic environment": {
    "prefix": "beg",
    "body": [
      "\\begin{${1:environment}}",
      "\t${2}",
      "\\end{${1:environment}}",
      "$0"
    ],
    "description": "Generic begin-end environment"
  },

  // ========================================================================
  // 2. 산술 및 기초 대수
  // ========================================================================

  "Fraction": {
    "prefix": "ff",
    "body": "\\frac{${1:numerator}}{${2:denominator}}${3}$0",
    "description": "Fraction"
  },

  "Fraction 1/2": {
    "prefix": "ff2",
    "body": "\\frac12${1}$0",
    "description": "Fraction 1/2"
  },

  "Square root": {
    "prefix": "sq",
    "body": "\\sqrt{${1}}${2}$0",
    "description": "Square root"
  },

  // ========================================================================
  // 3. 미분과 적분
  // ========================================================================

  "Ordinary derivative": {
    "prefix": "dd",
    "body": "\\frac{\\mathrm{d}${1:f}}{\\mathrm{d}${2:x}}${3}$0",
    "description": "Ordinary derivative"
  },

  "Second Ordinary derivative": {
    "prefix": "dd2",
    "body": "\\frac{\\mathrm{d}^{2}${1:f}}{\\mathrm{d}${2:x}^{2}}${3}$0",
    "description": "Second ordinary derivative"
  },

  "Ordinary derivative fraction": {
    "prefix": "ddx",
    "body": "\\frac{\\mathrm{d}}{\\mathrm{d}${1:x}}${2}$0",
    "description": "Ordinary derivative operator"
  },

  "Partial derivative": {
    "prefix": "pd",
    "body": "\\frac{\\partial ${1:f}}{\\partial ${2:x}}${3}$0",
    "description": "Partial derivative"
  },

  "Partial derivative fraction": {
    "prefix": "pdx",
    "body": "\\frac{\\partial}{\\partial ${1:x}}${2}$0",
    "description": "Partial derivative operator"
  },

  "Second Partial derivative": {
    "prefix": "pd2",
    "body": "\\frac{\\partial^{2} ${1:f}}{\\partial ${2:x}^{2}}${3}$0",
    "description": "Second partial derivative"
  },

  "Second Partial derivative with x and y": {
    "prefix": "pdxy",
    "body": "\\frac{\\partial^{2} ${1:f}}{\\partial ${2:x}\\,\\partial ${3:y}}${4}$0",
    "description": "Mixed second partial derivative"
  },

  "Integral": {
    "prefix": "intt",
    "body": "\\int_{${1:a}}^{${2:b}} ${3:f(x)}\\,\\mathrm{d}${4:x}$0",
    "description": "Definite integral"
  },

  "Gradient operator" : {
    "prefix": "nab",
    "body": "\\nabla{}$0",
    "description": "Gradient Operator"
  },

  // ========================================================================
  // 4. 대형 연산자와 함수
  // ========================================================================

  "Summation": {
    "prefix": "summ",
    "body": "\\sum_{${1:i=1}}^{${2:n}} ${3:a_i}$0",
    "description": "Summation"
  },

  "Summation with out sup": {
    "prefix": "sum",
    "body": "\\sum_{${1:i}} ${2:a_i}$0",
    "description": "Summation"
  },

  "Limit": {
    "prefix": "limm",
    "body": "\\lim_{${1:x}\\to ${2:0}} ${3:f(x)}$0",
    "description": "Limit"
  },

  "Product": {
    "prefix": "prod",
    "body": "\\prod_{${1:i=1}}^{${2:n}} ${3:a_i}$0",
    "description": "Product"
  },

  "Letter Exponential": {
    "prefix": "exp",
    "body": "\\exp \\left[  ${1}  \\right] ${2}$0",
    "description": "Exponential function"
  },

  "Determinant" : {
    "prefix" : "det",
    "body": "\\det{(${1})}${2}$0",
    "description": "Determinant function"
  },

  "log" : {
    "prefix" : "log",
    "body": "\\log{ ${1} }${2}$0",
    "description": "Logarithm function"
  },



  // ========================================================================
  // 5. 벡터 및 accent 연산자
  // ========================================================================

  "Bold vector": {
    "prefix": "bv",
    "body": "\\bm{${1}}${2}$0",
    "description": "Bold vector"
  },

  "Bold font": {
    "prefix": "bd",
    "body": "\\mathbf{${1}}${2}$0",
    "description": "Bold vector"
  },

  "hat operator": {
    "prefix": "hat",
    "body": "\\hat{${1}}${2}$0",
    "description": "Hat operator"
  },

  "bar operator": {
    "prefix": "bar",
    "body": "\\bar{${1}}${2}$0",
    "description": "Bar operator"
  },

  "tilde operator": {
    "prefix": "til",
    "body": "\\tilde{${1}}${2}$0",
    "description": "Tilde operator"
  },

  // ========================================================================
  // 6. 확률과 통계
  // ========================================================================

  "left right bracket Expected value": {
    "prefix": "xplr",
    "body": "\\E\\left[${1:X}\\right]${2}$0",
    "description": "Expected value with auto-sized brackets"
  },

  "Expected value": {
    "prefix": "xpv",
    "body": "\\E[${1:X}]${2}$0",
    "description": "Expected value"
  },

  "Conditional Expected value": {
    "prefix": "xpc",
    "body": "\\E\\left[${1:X} \\mid ${2:Y}\\right]${3}$0",
    "description": "Conditional Expected value"
  },

  "Variance": {
    "prefix": "varr",
    "body": "\\Var\\left(${1:X}\\right)${2}$0",
    "description": "Variance"
  },

  "Covariance": {
    "prefix": "covv",
    "body": "\\Cov\\left(${1:X}, ${2:Y}\\right)${3}$0",
    "description": "Covariance"
  },

  "Probability": {
    "prefix": "prob",
    "body": "\\Prob\\left(${1:A}\\right)${2}$0",
    "description": "Probability"
  },

  "Conditional probability text Pr": {
  "prefix": "cdp",
  "body": "\\text{Pr}\\left(${1:A}\\mid ${2:B}\\right)${3}$0",
  "description": "Conditional Pr with auto-sized parentheses"
  },

  // ========================================================================
  // 7. delimiter
  // ========================================================================

  "auto size Parentheses": {
    "prefix": "lrp",
    "body": "\\left( ${1} \\right)${2}$0",
    "description": "Auto-sized parentheses"
  },

  "auto size Brackets": {
    "prefix": "lrb",
    "body": "\\left[ ${1} \\right]${2}$0",
    "description": "Auto-sized brackets"
  },

  "auto size middle braket" : {
     "prefix": "lrm",
    "body": "\\left\\{ ${1} \\right\\\\}${2}$0",
    "description": "Auto-sized middle brackets"
  },

  "auto size conditional braket" : {
     "prefix": "cbb",
    "body": "\\left[  ${1} \\mid ${2} \\right]${3}$0",
    "description": "Auto-sized conditional brackets"
  },

  "auto size conditional parentheses" : {
     "prefix": "cpp",
    "body": "\\left(  ${1} \\mid ${2} \\right)${3}$0",
    "description": "Auto-sized conditional parentheses"
  },

  "conditional braket" : {
     "prefix": "cb",
    "body": "[  ${1} \\mid ${2} ]${3}$0",
    "description": "Auto-sized conditional brackets"
  },

  "parentheses" : {
     "prefix": "cp",
    "body": "(  ${1} \\mid ${2} )${3}$0",
    "description": "Auto-sized conditional parentheses"
  },

  // ========================================================================
  // 8. 그리스 문자 — suffix 오작동 방지를 위해 세미콜론 prefix 사용
  // ========================================================================

  "alpha": {
    "prefix": ";al",
    "body": "\\alpha{}$0",
    "description": "Greek letter alpha"
  },

  "beta": {
    "prefix": ";be",
    "body": "\\beta{}$0",
    "description": "Greek letter beta"
  },

  "gamma": {
    "prefix": ";ga",
    "body": "\\gamma{}$0",
    "description": "Greek letter gamma"
  },

  "delta": {
    "prefix": ";de",
    "body": "\\delta{}$0",
    "description": "Greek letter delta"
  },

  "epsilon": {
    "prefix": ";ep",
    "body": "\\epsilon{}$0",
    "description": "Greek letter epsilon"
  },

  "rho": {
    "prefix": ";ro",
    "body": "\\rho{}$0",
    "description": "Greek letter rho"
  },

  "pi": {
    "prefix": ";pi",
    "body": "\\pi{}$0",
    "description": "Greek letter pi"
  },

  "lambda": {
    "prefix": ";la",
    "body": "\\lambda{}$0",
    "description": "Greek letter lambda"
  },

  "sigma": {
    "prefix": ";si",
    "body": "\\sigma{}$0",
    "description": "Greek letter sigma"
  },

  "Sigma": {
    "prefix": ";Si",
    "body": "\\Sigma{}$0",
    "description": "Greek letter Sigma"
  },

  "theta": {
    "prefix": ";th",
    "body": "\\theta{}$0",
    "description": "Greek letter theta"
  },

  "phi": {
    "prefix": ";ph",
    "body": "\\phi{}$0",
    "description": "Greek letter phi"
  },

  "mu": {
    "prefix": ";mu",
    "body": "\\mu{}$0",
    "description": "Greek letter mu"
  },

  "nu": {
    "prefix": ";nu",
    "body": "\\nu{}$0",
    "description": "Greek letter nu"
  },

  "ell": {
    "prefix": ";el",
    "body": "\\ell{}$0",
    "description": "Greek letter ell"
  },

  // ========================================================================
  // 9. 텍스트, 폰트
  // ========================================================================

  "text" : {
    "prefix": "tt",
    "body": "\\text{$1}${2}$0",
    "description": "Input text"
  },

  "Fraktur font" : {
    "prefix": "mc",
    "body": "\\mathcal{$1}${2}$0",
    "description": "Fraktur font"
  },

  "Blackboard Bold font" : {
    "prefix": "mb",
    "body": "\\mathbb{$1}${2}$0",
    "description": "Blackboard bold font ( for set symbol )"
  },

   // ========================================================================
  // 10. 화학식, 기호 관련
  // ========================================================================
  "chemistry" : {
    "prefix": "ce",
    "body": "\\ce{$1}${2}$0",
    "description": "Chemical formula"
  },

  // ========================================================================
  // 11. 화살표
  // ========================================================================

  "right arrow with upper symbol" : {
    "prefix": "xra",
    "body": "\\xrightarrow{$1}${2}$0",
    "description": "right arrow with upper symbol"
  },

  "downarrow with newlines" : {
    "prefix": "drn",
    "body": [
      "\\\\\\\\",
      "\\downarrow",
      "\\\\\\\\",
      "$0"
    ],
    "description": "Downarrow with newlines"
  },

  // ========================================================================
  // 12. 특수기호 / 공백문자
  // ========================================================================
  "Infinity" : {
    "prefix": "infi",
    "body": "\\infty{}$0",
    "description": "infinity symbol"
  },

  "quad" : {
    "prefix": "qu",
    "body": "\\quad{}$0",
    "description": "quad white character"
  },
  "qquad" : {
    "prefix": "qq",
    "body": "\\qquad{}$0",
    "description": "qquad white character"
  },

}
