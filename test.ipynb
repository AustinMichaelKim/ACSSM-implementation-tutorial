     "text": [
      "tensor([[[[1, 0],\n",
      "          [0, 2]],\n",
      "\n",
      "         [[3, 0],\n",
      "          [0, 4]]],\n",
      "\n",
      "\n",
      "        [[[3, 0],\n",
      "          [0, 4]],\n",
      "\n",
      "         [[1, 0],\n",
      "          [0, 2]]]]) torch.Size([2, 2, 2, 2])\n"
     ]
    }
   ],
   "source": [
    "import torch\n",
    "\n",
    "A = [1,2]\n",
    "\n",
    "B = [3,4]\n",
    "\n",
    "eigen = torch.tensor(\n",
    "    [[A,B],\n",
    "     [B,A]]\n",
    "    )\n",
    "\n",
    "\n",
    "mat = torch.diag_embed(eigen)\n",
    "\n",
    "print(mat, mat.shape)"
   ]
  },
